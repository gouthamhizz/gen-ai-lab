# ===== Providers =====
LLM_PROVIDER=ollama             # ollama | gemini | openai   (openai == Gemini's OpenAI-compatible route)
LLM_FALLBACK_PROVIDER=gemini    # used automatically if the primary keeps failing ("" disables)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3             # run `ollama list` and copy the exact tag of your Llama-3 8B
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=                 # leave empty to reuse GEMINI_API_KEY
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.8-flash

# ===== Embeddings =====
EMBEDDING_BACKEND=local         # local (sentence-transformers) | gemini | hash (tests only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# ===== Infra =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
REDIS_URL=redis://localhost:6380/0

# ===== Observability (Step 11) =====
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# ===== API (Step 12) =====
API_KEYS=dev-key-change-me      # comma separated
